// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum BasePriority {
  low
  medium
  high
}

enum TaskStatus {
  pending
  completed
  graveyard
}

enum RescheduleReason {
  auto_overdue
  priority_battle_loss
  manual
}

enum PlanSource {
  mcp
  manual
}

// ─────────────────────────────────────────
// Models
// ─────────────────────────────────────────

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String              @unique
  passwordHash           String
  timezone               String              // IANA timezone, e.g. "America/New_York"
  dailyCapacityMinutes   Int                 @default(480)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tasks                  Task[]
  planGroups             PlanGroup[]
  mcpTokens              McpToken[]
  pushSubscriptions      PushSubscription[]

  @@map("users")
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  planId           String?          @db.Uuid
  title            String
  description      String?
  scheduledDate    DateTime         @db.Date
  estimatedMinutes Int
  basePriority     BasePriority
  compositeScore   Float            @default(0)
  bumpCount        Int              @default(0)
  status           TaskStatus       @default(pending)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             PlanGroup?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  rescheduleLogs   RescheduleLog[]

  @@index([userId])
  @@index([planId])
  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@map("tasks")
}

model PlanGroup {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  title           String
  goalDescription String
  source          PlanSource @default(mcp)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@index([userId])
  @@map("plan_groups")
}

model RescheduleLog {
  id        String           @id @default(uuid()) @db.Uuid
  taskId    String           @db.Uuid
  fromDate  DateTime         @db.Date
  toDate    DateTime         @db.Date
  reason    RescheduleReason
  createdAt DateTime         @default(now())

  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("reschedule_log")
}

model McpToken {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  accessTokenHash    String
  refreshTokenHash   String
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_tokens")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dhKey String
  authKey   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}